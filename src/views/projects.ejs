<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul class="project-list">
        <% projects.forEach(project => { %>
            <% const projectDate = new Date(project.project_date); %>
            <li>
                <span class="project-date">
                    <time datetime="<%= projectDate.toLocaleDateString('en-CA') %>"><%= projectDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>:
                </span>
                <span class="project-details">
                    <span class="project-title"><%= project.title %></span>
                    <span class="project-org">(<%= project.organization_name %>)</span>
                </span>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
