<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

  <form action="/edit-category/<%= categoryDetails.category_id %>" method="POST">
    <div class="form-group">
      <label for="name">Category Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="100"
        value="<%= categoryDetails.name %>"
      />
    </div>

    <button type="submit">Update Category</button>
  </form>

  <p><a class="back-link" href="/category/<%= categoryDetails.category_id %>">&larr; Back to category</a></p>
</main>
<%- include('partials/footer') %>
