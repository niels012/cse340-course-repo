<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <%
        const navLinks = [
            { href: '/', label: 'Home' },
            { href: '/organizations', label: 'Organizations' },
            { href: '/projects', label: 'Projects' },
            { href: '/categories', label: 'Categories' }
        ];

        // Account links (shown on the right side) depend on the login status (isLoggedIn is set in server.js)
        const accountLinks = isLoggedIn
            ? [{ href: '/logout', label: 'Logout' }]
            : [{ href: '/register', label: 'Register' }, { href: '/login', label: 'Login' }];
    %>
    <nav aria-label="Main navigation">
        <div class="nav-container">
            <ul>
                <% navLinks.forEach(link => { %>
                    <li>
                        <a href="<%= link.href %>"<% if (link.href === currentPath) { %> aria-current="page"<% } %>><%= link.label %></a>
                    </li>
                <% }); %>
            </ul>
            <ul class="nav-account" aria-label="Account">
                <% accountLinks.forEach(link => { %>
                    <li>
                        <a href="<%= link.href %>"<% if (link.href === currentPath) { %> aria-current="page"<% } %>><%= link.label %></a>
                    </li>
                <% }); %>
            </ul>
        </div>
    </nav>

    <%
        // Flash messages: shown below the navigation, above the page content
        const messages = flash();
        // autoDismiss = seconds before the message fades out on its own.
        // Errors stay (0) until the user closes them, so there is time to read and fix the problem.
        const alertStyles = {
            success: { icon: '✓', heading: 'Success', autoDismiss: 5 },
            error:   { icon: '!', heading: 'Please fix the following', autoDismiss: 0 },
            warning: { icon: '⚠', heading: 'Warning', autoDismiss: 5 },
            info:    { icon: 'i', heading: 'Note', autoDismiss: 5 }
        };
        const activeTypes = Object.keys(messages).filter(type => messages[type].length > 0);
    %>
    <% if (activeTypes.length > 0) { %>
        <div class="flash-messages">
            <% activeTypes.forEach(type => { %>
                <% const style = alertStyles[type] || alertStyles.info; %>
                <div class="alert <%= type %>" role="<%= type === 'error' ? 'alert' : 'status' %>"<% if (style.autoDismiss > 0) { %> style="--alert-timeout: <%= style.autoDismiss %>s" data-autodismiss<% } %>>
                    <span class="alert-icon" aria-hidden="true"><%= style.icon %></span>
                    <div class="alert-content">
                        <p class="alert-heading"><%= style.heading %></p>
                        <% if (messages[type].length === 1) { %>
                            <p class="alert-text"><%= messages[type][0] %></p>
                        <% } else { %>
                            <ul class="alert-list">
                                <% messages[type].forEach(msg => { %>
                                    <li><%= msg %></li>
                                <% }); %>
                            </ul>
                        <% } %>
                    </div>
                    <button type="button" class="alert-close" aria-label="Dismiss message">&times;</button>
                    <% if (style.autoDismiss > 0) { %>
                        <%# Countdown bar: when its animation ends, the message is dismissed %>
                        <span class="alert-progress" aria-hidden="true"></span>
                    <% } %>
                </div>
            <% }); %>
        </div>

        <script>
            // Flash messages: close button + auto-dismiss.
            // The countdown bar's CSS animation is the timer, so hovering the message
            // (or focusing its close button) pauses it, and leaving resumes it.
            (() => {
                const dismiss = (alert) => {
                    if (alert.classList.contains('alert-hiding')) return;
                    alert.classList.add('alert-hiding');

                    const remove = () => {
                        const container = alert.parentElement;
                        alert.remove();
                        // Remove the empty container so its spacing disappears too
                        if (container && container.children.length === 0) container.remove();
                    };
                    alert.addEventListener('animationend', (event) => {
                        if (event.animationName === 'alert-out') remove();
                    });
                    // Fallback in case animations are turned off
                    setTimeout(remove, 400);
                };

                document.querySelectorAll('.flash-messages .alert').forEach((alert) => {
                    alert.querySelector('.alert-close').addEventListener('click', () => dismiss(alert));

                    const progress = alert.querySelector('.alert-progress');
                    if (progress) {
                        progress.addEventListener('animationend', () => dismiss(alert));
                    }
                });
            })();
        </script>
    <% } %>
