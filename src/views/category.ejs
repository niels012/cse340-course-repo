<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Service Projects</h2>
    <% if (projects.length > 0) { %>
    <ul class="project-list">
        <% projects.forEach(project => { %>
        <% const projectDate = new Date(project.date); %>
        <li>
            <span class="project-date">
                <time datetime="<%= projectDate.toLocaleDateString('en-CA') %>"><%= projectDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
            </span>
            <a class="project-title" href="/project/<%= project.project_id %>"><%= project.title %></a>
        </li>
        <% }) %>
    </ul>
    <% } else { %>
    <p>There are no service projects in this category yet.</p>
    <% } %>
    <p><a class="back-link" href="/categories">&larr; Back to categories</a></p>
</main>

<%- include('partials/footer') %>
