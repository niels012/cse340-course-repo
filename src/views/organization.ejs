<%- include('partials/header') %>

<main>
    <article class="org-profile">
        <header class="org-header">
            <div>
                <p class="org-eyebrow">Partner Organization</p>
                <h1><%= title %></h1>
            </div>
            <img class="org-header-logo" src="<%= organization.logo_url %>" alt="<%= organization.name %> logo">
        </header>

        <div class="org-body">
            <section class="org-about">
                <h2>About</h2>
                <p><%= organization.description %></p>
            </section>

            <aside class="org-contact">
                <h2>Contact</h2>
                <p class="org-contact-label">Email</p>
                <p class="org-contact-value"><a href="mailto:<%= organization.email %>"><%= organization.email %></a></p>
                <a class="button" href="mailto:<%= organization.email %>">Send an email</a>
            </aside>
        </div>
    </article>

    <div class="page-actions">
        <a class="btn btn-outline" href="/edit-organization/<%= organization.organization_id %>">Edit Organization</a>
    </div>
    <p><a class="back-link" href="/organizations">&larr; Back to organizations</a></p>
</main>

<%- include('partials/footer') %>
