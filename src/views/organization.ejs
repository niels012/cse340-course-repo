<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <img class="detail-logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
    <dl class="detail-list">
        <dt>Description</dt>
        <dd><%= organization.description %></dd>
        <dt>Contact</dt>
        <dd><a href="mailto:<%= organization.email %>"><%= organization.email %></a></dd>
    </dl>
    <p><a href="/organizations">&larr; Back to organizations</a></p>
</main>

<%- include('partials/footer') %>
