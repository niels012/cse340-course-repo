<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

  <%# enctype="multipart/form-data" is required so the form can send the logo file %>
  <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="150"
        value="<%= organizationDetails.name %>"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
        maxlength="500"
      ><%= organizationDetails.description %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        required
        value="<%= organizationDetails.email %>"
      />
    </div>

    <div class="form-group">
      <label for="logo">Logo</label>
      <div class="logo-field">
        <img
          id="logoPreview"
          class="logo-preview"
          src="<%= organizationDetails.logo_url %>"
          alt="Current <%= organizationDetails.name %> logo"
        />
        <div class="logo-field-input">
          <input
            type="file"
            id="logo"
            name="logo"
            accept="image/png, image/jpeg, image/gif, image/webp"
            aria-describedby="logoHelp"
          />
          <p id="logoHelp" class="field-help">PNG, JPG, GIF, or WebP, up to 2 MB. Leave empty to keep the current logo.</p>
        </div>
      </div>
    </div>

    <button type="submit">Update Organization</button>
  </form>

  <p><a class="back-link" href="/organization/<%= organizationDetails.organization_id %>">&larr; Back to organization</a></p>
</main>

<script>
  // Client-side check and preview for the logo (the server checks again)
  (() => {
    const input = document.getElementById('logo');
    const preview = document.getElementById('logoPreview');
    const originalSrc = preview.src;
    const allowedTypes = ['image/png', 'image/jpeg', 'image/gif', 'image/webp'];
    const maxSize = 2 * 1024 * 1024;

    input.addEventListener('change', () => {
      const file = input.files[0];
      input.setCustomValidity('');

      if (!file) {
        preview.src = originalSrc;
        return;
      }
      if (!allowedTypes.includes(file.type)) {
        input.setCustomValidity('Please choose a PNG, JPG, GIF, or WebP image.');
      } else if (file.size > maxSize) {
        input.setCustomValidity('Logo image must be 2 MB or smaller.');
      }

      if (input.validity.valid) {
        preview.src = URL.createObjectURL(file);
      } else {
        preview.src = originalSrc;
        input.reportValidity();
      }
    });
  })();
</script>
<%- include('partials/footer') %>
