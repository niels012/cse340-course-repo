<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    <ul class="org-list">
        <% organizations.forEach(organization => { %>
            <li>
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                <strong><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></strong>: <%= organization.email %>
            </li>
        <% }); %>
    </ul>
    <div class="page-actions">
        <a class="btn btn-primary" href="/new-organization"><span class="btn-icon" aria-hidden="true">+</span> Add a New Organization</a>
    </div>
</main>

<%- include('partials/footer') %>